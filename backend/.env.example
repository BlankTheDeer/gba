##############################################################
#  BlankTB Portal Backend — Magical Environment Config 
#  Managed by Blank The Deer 
#  This file controls every sparkle & secret of the backend!
#  (Keep it safe & never share your real version publicly!)
##############################################################

#Core Application Info
APP_NAME="BlankTB Portal Backend"
APP_VERSION="1.0.0"
DOMAIN="https://portal.blanktb.net"
ENVIRONMENT="production"          # dev | staging | production
PORT=8080
HOST="0.0.0.0"
TIMEZONE="America/Los_Angeles"
DEBUG=false
DEVELOPER_MODE=false
FORCE_SSL_REDIRECT=true
FASTAPI_WORKERS=2

#MongoDB Settings (where your data forest lives!)
MONGO_URI=""
MONGO_DB_NAME="blanktb_portal"
MONGO_COLLECTION_PREFIX=""
MONGO_CONNECT_TIMEOUT_MS=3000
MONGO_SOCKET_TIMEOUT_MS=3000

#Discord Webhooks (cute alerts to your forest hub)
DISCORD_ALERT_WEBHOOK=""
DISCORD_UPTIME_WEBHOOK=""
DISCORD_ADMIN_WEBHOOK=""
DISCORD_HEALTHCHECK_WEBHOOK=""
DISCORD_DEBUG_WEBHOOK=""

#Status & Uptime Monitor (keeps the forest heartbeat visible)
RETENTION_DAYS=30
LOG_INTERVAL_MINUTES=10
CACHE_TTL_MINUTES=10
STATUS_ALERT_FILE="/home/blankthedeer/gba/backend/status_alerts.json"
STATUS_CACHE_FILE="/home/blankthedeer/gba/backend/status_cache.json"
HEALTHCHECK_TIMEOUT=10
HEALTHCHECK_FAIL_THRESHOLD=3
ALERT_DELAY_MINUTES=5

#Email Magic (for sending confirmations & gentle reminders)
MAIL_ENABLED=true
MAIL_FROM_NAME="BlankTB Portal"
MAIL_FROM_EMAIL="no-reply@blanktb.net"
MAIL_SERVER="smtp.blanktb.net"
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_TLS=true
MAIL_SSL=false

#Security & Tokens
SECRET_KEY=""                      # Random 32+ char secret key
PASSWORD_SALT_ROUNDS=12
JWT_EXPIRY_HOURS=24

#reCAPTCHA Fairy (anti-bot protection, optional)
ENABLE_RECAPTCHA=false
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

#Branding (for emails, embeds, and frontend sync)
BRAND_NAME="Blank The Deer"
BRAND_PRIMARY_COLOR="#e6b7ff"
BRAND_ACCENT_COLOR="#b8f8ff"
BRAND_LOGO_URL="https://blanktb.net/static/logo.png"
BRAND_FAVICON_URL="https://blanktb.net/static/favicon.ico"

# ?? File Paths (forest directories for uploads & logs)
DATA_DIR="/home/blankthedeer/gba/data"
UPLOAD_DIR="/home/blankthedeer/gba/uploads"
TEMP_DIR="/home/blankthedeer/gba/tmp"
BACKUP_DIR="/home/blankthedeer/gba/backups"
LOG_DIR="/home/blankthedeer/gba/logs"

#Backend Control
ADMIN_API_KEY=""
ENABLE_EMAIL_SERVICE=true
ENABLE_PUBLIC_STATUS=true
ENABLE_ANALYTICS=false
ENABLE_DISCORD_ALERTS=true

#Internal Links
BACKEND_BASE_URL="https://backend.blanktb.net"
HOME="/home/blankthedeer"

##############################################################
# ?? End of configuration — may your backend run like starlight!
##############################################################
