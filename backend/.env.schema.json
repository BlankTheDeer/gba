{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "BlankTB Portal Backend Environment Schema",
  "description": "Defines all environment variables required by the backend.",
  "type": "object",
  "properties": {
    "APP_NAME": { "type": "string", "default": "BlankTB Portal Backend", "description": "Name of the backend service." },
    "APP_VERSION": { "type": "string", "default": "1.0.0", "description": "Version number for display or debugging." },
    "DOMAIN": { "type": "string", "description": "Primary domain or base URL of the service." },
    "ENVIRONMENT": { "type": "string", "enum": ["development", "staging", "production"], "description": "Runtime environment mode." },
    "PORT": { "type": "integer", "default": 8080, "description": "Port to run the FastAPI server on." },
    "HOST": { "type": "string", "default": "0.0.0.0", "description": "Host address to bind to." },
    "TIMEZONE": { "type": "string", "default": "UTC", "description": "Local timezone for date and log operations." },
    "DEBUG": { "type": "boolean", "default": false, "description": "Enable verbose debugging mode." },
    "DEVELOPER_MODE": { "type": "boolean", "default": false, "description": "Activates development-only features." },
    "FORCE_SSL_REDIRECT": { "type": "boolean", "default": true, "description": "Force redirect to HTTPS." },
    "FASTAPI_WORKERS": { "type": "integer", "default": 2, "description": "Number of FastAPI worker processes." },

    "MONGO_URI": { "type": "string", "description": "Full MongoDB connection URI." },
    "MONGO_DB_NAME": { "type": "string", "default": "bot_database", "description": "Name of the main database." },
    "MONGO_COLLECTION_PREFIX": { "type": "string", "default": "", "description": "Optional prefix for collection names." },
    "MONGO_CONNECT_TIMEOUT_MS": { "type": "integer", "default": 3000, "description": "MongoDB connection timeout." },
    "MONGO_SOCKET_TIMEOUT_MS": { "type": "integer", "default": 3000, "description": "MongoDB socket timeout." },

    "DISCORD_ALERT_WEBHOOK": { "type": "string", "description": "Webhook for system alert notifications." },
    "DISCORD_UPTIME_WEBHOOK": { "type": "string", "description": "Webhook for uptime status messages." },
    "DISCORD_ADMIN_WEBHOOK": { "type": "string", "description": "Webhook for admin alerts or escalations." },
    "DISCORD_HEALTHCHECK_WEBHOOK": { "type": "string", "description": "Webhook for healthcheck updates." },
    "DISCORD_DEBUG_WEBHOOK": { "type": "string", "description": "Webhook for debug messages or errors." },

    "RETENTION_DAYS": { "type": "integer", "default": 30, "description": "Number of days to retain status logs." },
    "LOG_INTERVAL_MINUTES": { "type": "integer", "default": 10, "description": "Interval between log entries in minutes." },
    "CACHE_TTL_MINUTES": { "type": "integer", "default": 10, "description": "Cache time-to-live for in-memory data." },
    "STATUS_ALERT_FILE": { "type": "string", "description": "Path to JSON alert cache for system status." },
    "STATUS_CACHE_FILE": { "type": "string", "description": "Path to JSON cache for service status." },
    "HEALTHCHECK_TIMEOUT": { "type": "integer", "default": 10, "description": "Timeout for healthcheck requests in seconds." },
    "HEALTHCHECK_FAIL_THRESHOLD": { "type": "integer", "default": 3, "description": "Failure count before triggering an alert." },
    "ALERT_DELAY_MINUTES": { "type": "integer", "default": 5, "description": "Minimum time between alert messages." },

    "MAIL_ENABLED": { "type": "boolean", "default": true, "description": "Enable or disable email service." },
    "MAIL_FROM_NAME": { "type": "string", "description": "Display name for outgoing emails." },
    "MAIL_FROM_EMAIL": { "type": "string", "description": "From address for email messages." },
    "MAIL_SERVER": { "type": "string", "description": "SMTP server hostname." },
    "MAIL_PORT": { "type": "integer", "default": 587, "description": "SMTP port." },
    "MAIL_USERNAME": { "type": "string", "description": "Username for SMTP authentication." },
    "MAIL_PASSWORD": { "type": "string", "description": "Password for SMTP authentication." },
    "MAIL_TLS": { "type": "boolean", "default": true, "description": "Enable TLS for email connection." },
    "MAIL_SSL": { "type": "boolean", "default": false, "description": "Enable SSL for email connection." },

    "SECRET_KEY": { "type": "string", "description": "JWT signing secret key." },
    "PASSWORD_SALT_ROUNDS": { "type": "integer", "default": 12, "description": "Number of bcrypt salt rounds." },
    "JWT_EXPIRY_HOURS": { "type": "integer", "default": 24, "description": "JWT expiration time in hours." },

    "ENABLE_RECAPTCHA": { "type": "boolean", "default": false, "description": "Enable Google reCAPTCHA." },
    "RECAPTCHA_ENABLED": { "type": "boolean", "default": false, "description": "Alias for ENABLE_RECAPTCHA." },
    "RECAPTCHA_SITE_KEY": { "type": "string", "description": "Google reCAPTCHA site key." },
    "RECAPTCHA_SECRET_KEY": { "type": "string", "description": "Google reCAPTCHA secret key." },

    "BRAND_NAME": { "type": "string", "default": "Blank The Deer", "description": "Brand name used in UI and emails." },
    "BRAND_PRIMARY_COLOR": { "type": "string", "default": "#e6b7ff", "description": "Main brand color (pastel lavender)." },
    "BRAND_ACCENT_COLOR": { "type": "string", "default": "#b8f8ff", "description": "Accent color (pastel teal)." },
    "BRAND_LOGO_URL": { "type": "string", "description": "Full URL to brand logo." },
    "BRAND_FAVICON_URL": { "type": "string", "description": "Full URL to favicon image." },

    "DATA_DIR": { "type": "string", "description": "Directory for saved user/emulator data." },
    "UPLOAD_DIR": { "type": "string", "description": "Directory for user file uploads." },
    "TEMP_DIR": { "type": "string", "description": "Temporary files directory." },
    "BACKUP_DIR": { "type": "string", "description": "Directory for scheduled backups." },
    "LOG_DIR": { "type": "string", "description": "Directory for backend log files." },

    "ADMIN_API_KEY": { "type": "string", "description": "Internal admin API access key." },
    "ENABLE_EMAIL_SERVICE": { "type": "boolean", "default": true, "description": "Enable email-based features." },
    "ENABLE_PUBLIC_STATUS": { "type": "boolean", "default": true, "description": "Expose public uptime/status page." },
    "ENABLE_ANALYTICS": { "type": "boolean", "default": false, "description": "Enable optional analytics." },
    "ENABLE_DISCORD_ALERTS": { "type": "boolean", "default": true, "description": "Send alerts to Discord webhooks." },

    "BACKEND_BASE_URL": { "type": "string", "description": "Base URL for internal backend references." },
    "HOME": { "type": "string", "description": "Server home directory for runtime operations." }
  },
  "required": ["APP_NAME", "DOMAIN", "MONGO_URI", "SECRET_KEY"]
}
